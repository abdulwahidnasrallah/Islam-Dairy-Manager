{
  "name": "islam-dairy-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Islam Dairy Manager (IDM) - Offline Desktop ERP for \u0625\u0633\u0644\u0627\u0645 \u0644\u0644\u0623\u0644\u0628\u0627\u0646 \u0648\u0627\u0644\u0623\u062c\u0628\u0627\u0646",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/** run dev",
    "frontend": "pnpm --filter frontend run dev",
    "backend": "pnpm --filter backend run dev",
    "desktop": "pnpm --filter desktop run dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter database run generate",
    "db:migrate": "pnpm --filter database run migrate",
    "db:seed": "pnpm --filter database run seed",
    "db:build-template": "pnpm --filter database run build:template",
    "package:win": "pnpm build && pnpm db:build-template && pnpm --filter desktop run package:win",
    "lint": "pnpm -r run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "test": "pnpm -r run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "eslint": "^9.9.0",
    "@eslint/js": "^9.9.0",
    "typescript-eslint": "^8.1.0"
  },
  "packageManager": "pnpm@9.7.0"
}
