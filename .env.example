# ── Database ─────────────────────────────────────────────
DATABASE_URL="file:./database/dev.db"

# ── Backend ──────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Generate a real random value for production. Never commit the real value.
SESSION_SECRET="replace-with-a-long-random-string"

APP_VERSION="0.1.0"
APP_NAME="Islam Dairy Manager"
STORE_NAME_AR="إسلام للألبان والأجبان"

# ── AI Assistant (Phase 8, optional) ────────────────────
# Leave empty to disable the assistant — every other module works
# without it. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""
ASSISTANT_MODEL="claude-sonnet-5"
