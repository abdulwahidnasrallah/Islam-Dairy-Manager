{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      "@/*": ["apps/frontend/src/*"],
      "@idm/shared-types": ["../../packages/shared-types/src"],
      "@idm/shared-validation": ["../../packages/shared-validation/src"],
      "@idm/shared-utils": ["../../packages/shared-utils/src"]
    }
  },
  "include": ["src"]
}
