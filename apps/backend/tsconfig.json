{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"],
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@idm/shared-types": ["../../packages/shared-types/dist"],
      "@idm/shared-validation": ["../../packages/shared-validation/dist"],
      "@idm/shared-utils": ["../../packages/shared-utils/dist"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
