{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@idm/shared-types": ["packages/shared-types/src"],
      "@idm/shared-types/*": ["packages/shared-types/src/*"],
      "@idm/shared-validation": ["packages/shared-validation/src"],
      "@idm/shared-validation/*": ["packages/shared-validation/src/*"],
      "@idm/shared-utils": ["packages/shared-utils/src"],
      "@idm/shared-utils/*": ["packages/shared-utils/src/*"]
    }
  }
}
